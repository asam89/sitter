# Production env for docker-compose.prod.yml. Copy to `.env` on the host and
# fill in. NEVER commit the filled-in .env.

# --- Database (stays inside the compose network; not exposed to the internet) ---
POSTGRES_USER=postgres
# Use a long random password:  openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=sitbaby

# --- Auth (required) ---
# Generate:  openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
# Must match how users reach the site (https + your domain in prod).
NEXTAUTH_URL=https://sitbaby.example.com

# --- Reverse proxy / TLS ---
# A domain → automatic HTTPS via Let's Encrypt. Use ":80" for plain HTTP only.
SITE_ADDRESS=sitbaby.example.com
# ACME account email for cert-expiry notices (optional but recommended).
TLS_EMAIL=admin@example.com

# --- Seeding ---
# Keep false in prod. Set true only on a throwaway demo box to load demo accounts.
SEED_ON_START=false

# --- Business rule defaults (also editable at runtime via /admin/settings) ---
LAST_MINUTE_THRESHOLD_HOURS=12
RUSH_FEE_TYPE=PERCENT
RUSH_FEE_AMOUNT=25
PLATFORM_FEE_TYPE=PERCENT
PLATFORM_FEE_AMOUNT=15

# --- Stripe (optional; leave blank for mock payment mode) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
