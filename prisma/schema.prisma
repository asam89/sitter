// Sitbaby — Agency-vetted babysitter scheduling & booking platform.
// The trust layer is the business itself: Sitbaby (Admin) vets every sitter and
// curates who is *listed* (bookable). See docs/sitbaby-agency-model-notes.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum Role {
  PARENT
  SITTER
  ADMIN
}

// Sitter application lifecycle (manual Admin review; no automated bg-check API).
enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  INTERVIEW
  VETTED
  REJECTED
}

enum SlotStatus {
  OPEN
  BOOKED
}

// An open call for a sitter: a parent asked for a time nobody has published
// availability for. Sitters (or Admin) pick it up, which turns it into a Booking.
enum BookingRequestStatus {
  OPEN
  CLAIMED
  CANCELLED
}

enum BookingStatus {
  REQUESTED // parent booked; slot held; awaiting sitter approval
  APPROVED // sitter approved at the Admin-set rate; address released; parent pays into escrow
  DECLINED // sitter declined; slot returned to OPEN
  IN_PROGRESS // job underway (on/after the scheduled start)
  COMPLETED // marked complete; payout released to sitter
  CANCELLED
}

// Channel a booking notification was dispatched over.
enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  SENT
  STUBBED // no provider configured; logged only (dev)
  FAILED
}

// Who confirms a booking is complete (releases payout). Configurable per business.
enum CompletionConfirmer {
  PARENT
  ADMIN
}

enum FeeType {
  FLAT
  PERCENT
}

// Which rung of the cancellation policy a refund was resolved against. Stored
// on the booking so a refund can always be explained after the fact.
enum InterviewStatus {
  NONE
  REQUESTED
  SCHEDULED
  DECLINED
  COMPLETED
}

// How the parent pays. E-transfer settles outside the app, so an Admin records
// the receipt manually.
enum PaymentMethod {
  CARD
  ETRANSFER
}

enum RefundTier {
  UNPAID // nothing had been charged
  PARENT_EARLY // parent cancelled outside the full-refund window
  PARENT_MID // parent cancelled between the two windows
  PARENT_LATE // parent cancelled inside the late window
  PARENT_AFTER_START // cancelled at/after the start time
  SITTER_CANCELLED // sitter backed out
  ADMIN_CANCELLED // Ri'aya cancelled
}

enum ReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

// Parent account KYC tiers. Booking is gated on reaching an Admin-configured
// minimum level (BusinessSettings.minParentVerificationLevelToBook).
enum VerificationLevel {
  LEVEL_0_REGISTERED // email + password only; can browse, cannot book
  LEVEL_1_CONTACT // email + phone verified
  LEVEL_2_IDENTITY // government ID verified + address on file
}

// Channel for a one-time verification code.
enum VerificationChannel {
  EMAIL
  PHONE
}

// Manual ID-review lifecycle (used only on the manual-review MVP path).
enum IdReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------- Core ----------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  role         Role    @default(PARENT)
  phone        String?
  suspended    Boolean @default(false)

  // --- KYC / verification ---
  emailVerified     DateTime? // set when the email code is confirmed
  phoneVerified     Boolean           @default(false)
  verificationLevel VerificationLevel @default(LEVEL_0_REGISTERED)

  // --- Newsletter / marketing consent (CASL) ---
  // Consent must be express and provable: we keep when it was given and the
  // exact wording shown at the time, plus an unsubscribe token so every
  // marketing send can carry a working one-click opt-out.
  newsletterOptIn       Boolean   @default(false)
  newsletterConsentAt   DateTime?
  newsletterConsentText String?
  newsletterOptOutAt    DateTime?
  unsubscribeToken      String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentProfile ParentProfile?
  sitterProfile SitterProfile?
  application   SitterApplication?

  parentBookings       Booking[]                @relation("ParentBookings")
  sitterBookings       Booking[]                @relation("SitterBookings")
  bookingRequests      BookingRequest[]         @relation("ParentBookingRequests")
  requestsClaimed      BookingRequest[]         @relation("SitterClaimedRequests")
  applicationsReviewed SitterApplication[]      @relation("ApplicationReviewer")
  messages             Message[]
  reportsMade          Report[]                 @relation("Reporter")
  verificationCodes    VerificationCode[]
  passwordResetTokens  PasswordResetToken[]
  idDocsReviewed       IdVerificationDocument[] @relation("IdDocReviewer")
  notifications        Notification[]           @relation("UserNotifications")
  campaigns            EmailCampaign[]          @relation("AdminCampaigns")
  auditActions         AdminAuditLog[]          @relation("AuditActor")
  auditEntries         AdminAuditLog[]          @relation("AuditTarget")
  reviewsWritten       Review[]                 @relation("ReviewsWritten")
  reviewsReceived      Review[]                 @relation("ReviewsReceived")
  bookingsCreated      Booking[]                @relation("AdminCreatedBookings")
  paymentsRecorded     Booking[]                @relation("BookingPaymentsRecorded")
}

// Hashed one-time verification codes for email/phone. The raw code is never
// stored; only a bcrypt hash. Rows are single-use (consumedAt) and expiring.
model VerificationCode {
  id         String              @id @default(cuid())
  userId     String
  channel    VerificationChannel
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel])
}

// Single-use, time-limited password reset tokens. Only the SHA-256 hash of the
// token is stored; the raw token lives only in the emailed reset link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ParentProfile {
  id      String  @id @default(cuid())
  userId  String  @unique
  address String? // legacy free-text; retained for existing data
  city    String?

  // --- Service address (released to a sitter only on booking confirmation) ---
  streetAddress String?
  unit          String?
  postalCode    String?
  province      String?

  // --- Identity verification ---
  identityVerified       Boolean   @default(false)
  verifiedName           String? // name as confirmed by ID review/provider
  idVerificationProvider String? // e.g. "manual", "stripe_identity"
  idVerifiedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  idDocs IdVerificationDocument[]
}

// Uploaded government-ID document (manual-review MVP path). storagePath points
// at a PRIVATE bucket/dir — never a public URL. The raw document is deleted
// (deletedAt set, storagePath cleared) once verification passes.
model IdVerificationDocument {
  id                String         @id @default(cuid())
  parentProfileId   String
  storagePath       String? // private path; cleared on deletion
  reviewStatus      IdReviewStatus @default(PENDING)
  reviewedByAdminId String?
  reviewedAt        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())

  parentProfile ParentProfile @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  reviewedBy    User?         @relation("IdDocReviewer", fields: [reviewedByAdminId], references: [id])

  @@index([reviewStatus])
  @@index([parentProfileId])
}

// A sitter's application. targetPayRate is the sitter's *requested* rate — a
// proposal. It is stored here permanently and is NEVER overwritten by the
// Admin-set listed rate (which lives on SitterProfile.listedPayRate).
model SitterApplication {
  id                   String            @id @default(cuid())
  userId               String            @unique
  bio                  String
  experience           String
  certifications       String[] // free-text labels, e.g. "CPR", "First Aid"
  documentUrls         String[] // uploaded doc URLs (CPR cert, police check, etc.)
  targetPayRate        Int // sitter's requested hourly rate (whole CAD)
  // Mobile number the applicant is reachable on, plus whether that number is on
  // WhatsApp. Nullable because applications predate this field.
  whatsappPhone        String?
  whatsappReachable    Boolean           @default(false)
  status               ApplicationStatus @default(APPLIED)
  reviewedByAdminId    String?
  reviewedAt           DateTime?
  adminNotes           String?
  // Interview stage: an applicant enters INTERVIEW when the Admin team wants to
  // meet them before vetting. interviewScheduledAt is optional (set only if the
  // team books a specific time the applicant can see); interviewNotes are the
  // internal write-up the reviewers record before deciding.
  interviewScheduledAt DateTime?
  interviewNotes       String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ApplicationReviewer", fields: [reviewedByAdminId], references: [id])

  @@index([status])
}

// Created only when Admin VETS an application. listedPayRate is the Admin-set
// rate; isListed is the curation gate (controlled exclusively by Admin) that
// decides whether the sitter appears in any parent-facing view.
model SitterProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String?
  city            String?
  listedPayRate   Int // Admin-set hourly rate (whole CAD) — distinct from targetPayRate
  // Sitter-set hourly rate. Sitters price their own time; listedPayRate is the
  // Admin-set fallback used until a sitter sets one. See effectiveRate().
  baseRate        Int?
  isListed        Boolean  @default(false)
  // Public profile photo (opaque filename in public storage; not a public URL).
  // Served through /api/sitter/[id]/photo. Null = show initials avatar instead.
  photoPath       String?
  // Sitter consent to appear publicly on the "Meet our team" page. Default off.
  publicOptIn     Boolean  @default(false)
  // Admin approval to feature this sitter publicly. Both publicOptIn AND
  // showcased must be true (and isListed) before a sitter appears publicly.
  showcased       Boolean  @default(false)
  serviceRadiusKm Int      @default(15)
  vettedAt        DateTime @default(now())
  stripeAccountId String? // Stripe Connect Express connected account (test mode)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots AvailabilitySlot[]

  @@index([isListed])
}

model AvailabilitySlot {
  id                   String     @id @default(cuid())
  sitterProfileId      String
  startTime            DateTime
  endTime              DateTime
  status               SlotStatus @default(OPEN)
  // Sitter opts a slot in for last-minute work; a booking inside the
  // configurable lead-time threshold still flags last-minute + adds the rush fee.
  isLastMinuteEligible Boolean    @default(false)
  createdAt            DateTime   @default(now())

  sitterProfile SitterProfile @relation(fields: [sitterProfileId], references: [id], onDelete: Cascade)
  booking       Booking?

  @@index([sitterProfileId, status])
  @@index([startTime])
}

model Booking {
  id                 String   @id @default(cuid())
  // Short, human-quotable reference (rendered as RB-000123) for support and
  // admin lookup — the cuid stays the internal/URL identifier.
  bookingNumber      Int      @unique @default(autoincrement())
  parentId           String
  sitterId           String
  availabilitySlotId String   @unique
  dateTime           DateTime
  durationHours      Int
  childrenAgeRange   String // e.g. "2-5" — no names/photos (data minimization)
  numberOfChildren   Int      @default(1)
  notes              String?

  // Pricing snapshot (taken at booking time so later settings changes don't
  // retroactively alter a confirmed booking). Every surcharge is stored as its
  // own line item because the parent is shown an itemised total before paying.
  listedRateSnapshot  Int
  baseAmount          Int // listedRate * durationHours
  isLastMinute        Boolean @default(false)
  rushFeeAmount       Int     @default(0) // computed, disclosed as its own line item
  extraChildFeeAmount Int     @default(0) // per additional child beyond the first
  lateNightFeeAmount  Int     @default(0) // session overlaps the late-night window
  overnightFeeAmount  Int     @default(0) // session overlaps the overnight window
  platformFeeAmount   Int     @default(0)
  totalAmount         Int // what the parent is charged

  // Waiver acceptance record. IP and user-agent are kept alongside the version
  // and timestamp so an acceptance can be evidenced later.
  // waiverAcceptedAt is null only while acceptance is outstanding, which happens
  // for a booking an Admin entered on the parent's behalf: the parent accepts
  // before paying, so no session runs without a waiver on file.
  waiverVersion           String
  waiverAcceptedAt        DateTime?
  waiverAcceptedIp        String?
  waiverAcceptedUserAgent String?

  status                   BookingStatus   @default(REQUESTED)
  // Set when an Admin entered the booking on the parent's behalf (phone/walk-in).
  createdByAdminId         String?
  paymentMethod            PaymentMethod?
  // Admin who recorded an offline (e-transfer) payment.
  paidRecordedById         String?
  stripePaymentIntentId    String?
  approvedAt               DateTime?
  declinedAt               DateTime?
  addressReleasedAt        DateTime? // set when the sitter approves and the address unlocks
  paidAt                   DateTime?
  startedAt                DateTime? // set when moved to IN_PROGRESS
  completedAt              DateTime?
  payoutReleasedAt         DateTime?
  cancelledAt              DateTime?
  cancellationChargeAmount Int             @default(0) // amount the parent forfeits (total - refund)
  // Refund outcome, resolved by the tiered policy at cancellation time.
  refundAmount             Int             @default(0)
  refundPercent            Int?
  refundTier               RefundTier?
  cancelledByUserId        String?
  cancelledByRole          Role?
  cancellationReason       String?
  // Optional parent/sitter intro call before the session. Never blocks the
  // booking: it is a comfort step, not a gate.
  interviewStatus          InterviewStatus @default(NONE)
  interviewRequestedAt     DateTime?
  interviewScheduledAt     DateTime?
  interviewMethod          String? // "Phone call", "Video call", "In person"
  interviewNote            String?
  refundProcessorId        String? // Stripe refund id, null for mock payments
  refundProcessorStatus    String? // "mock" when no real charge existed
  // Pre-session reminders, stamped so a cron re-run can't send twice.
  reminderSentAt           DateTime?
  finalReminderSentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent           User                 @relation("ParentBookings", fields: [parentId], references: [id])
  sitter           User                 @relation("SitterBookings", fields: [sitterId], references: [id])
  createdByAdmin   User?                @relation("AdminCreatedBookings", fields: [createdByAdminId], references: [id])
  paidRecordedBy   User?                @relation("BookingPaymentsRecorded", fields: [paidRecordedById], references: [id])
  availabilitySlot AvailabilitySlot     @relation(fields: [availabilitySlotId], references: [id])
  messages         Message[]
  reports          Report[]
  notifications    Notification[]
  childMedical     ChildMedicalRecord[]
  reviews          Review[]
  openRequest      BookingRequest?

  @@index([status])
  @@index([parentId])
  @@index([sitterId])
}

// A parent's request for a time no sitter has published availability for. It is
// broadcast to Admin and every listed sitter; the first sitter to claim it (or
// an Admin assignment) creates the AvailabilitySlot + Booking, so a request is
// never itself a commitment. The waiver is accepted up front, at request time.
//
// The hourly rate is deliberately NOT snapshotted here: it depends on which
// sitter picks the request up, so pricing is computed at claim time from that
// sitter's Admin-set listedPayRate.
model BookingRequest {
  id                      String               @id @default(cuid())
  requestNumber           Int                  @unique @default(autoincrement())
  parentId                String
  startTime               DateTime
  durationHours           Int
  childrenAgeRange        String
  numberOfChildren        Int                  @default(1)
  notes                   String?
  waiverVersion           String
  waiverAcceptedAt        DateTime
  waiverAcceptedIp        String?
  waiverAcceptedUserAgent String?
  status                  BookingRequestStatus @default(OPEN)
  claimedById             String? // sitter who picked it up
  claimedAt               DateTime?
  bookingId               String?              @unique // the Booking created on claim
  cancelledAt             DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  parent       User                 @relation("ParentBookingRequests", fields: [parentId], references: [id], onDelete: Cascade)
  claimedBy    User?                @relation("SitterClaimedRequests", fields: [claimedById], references: [id])
  booking      Booking?             @relation(fields: [bookingId], references: [id])
  childMedical ChildMedicalRecord[]

  @@index([status, startTime])
  @@index([parentId])
}

// Per-child health information, encrypted at rest (AES-256-GCM in
// src/lib/child-medical.ts). Only the parent who entered it and the assigned
// sitter (after payment) can decrypt it; rows are purged after purgeAfter.
// PENDING PRIVACY REVIEW before production use.
model ChildMedicalRecord {
  id               String   @id @default(cuid())
  bookingId        String?
  bookingRequestId String?
  childIndex       Int
  label            String
  ageYears         Int?
  encrypted        String // iv.ciphertext.tag, base64url
  purgeAfter       DateTime
  createdAt        DateTime @default(now())

  booking        Booking?        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingRequest BookingRequest? @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([bookingRequestId])
  @@index([purgeAfter])
}

// Audience an Admin broadcast was sent to. Express = the parent ticked the
// newsletter box; REGISTERED relies on CASL's implied consent from an existing
// business relationship, which expires 2 years after signup or last booking.
enum CampaignAudienceKind {
  NEWSLETTER
  REGISTERED
}

// Record of an Admin changing another account's role or suspension, so a
// privilege change is always attributable after the fact.
model AdminAuditLog {
  id           String   @id @default(cuid())
  actorId      String
  targetUserId String
  action       String // e.g. "role:PARENT->ADMIN"
  detail       String?
  createdAt    DateTime @default(now())

  actor  User @relation("AuditActor", fields: [actorId], references: [id])
  target User @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@index([createdAt])
  @@index([targetUserId])
}

// One Admin email broadcast to parents. Only parents with express newsletter
// consent on file receive it (CASL), and the send is recorded so it is
// auditable after the fact.
model EmailCampaign {
  id              String               @id @default(cuid())
  subject         String
  body            String
  sentByUserId    String
  audience        CampaignAudienceKind @default(NEWSLETTER)
  recipientCount  Int                  @default(0)
  failureCount    Int                  @default(0)
  suppressedCount Int                  @default(0)
  sentAt          DateTime             @default(now())

  sentBy User @relation("AdminCampaigns", fields: [sentByUserId], references: [id])

  @@index([sentAt])
}

// Newsletter sign-ups from people who may not have an account (public form in
// the footer/home page). CASL wants provable express consent, so the row keeps
// the wording shown and the request metadata, and the address is only mailable
// once the recipient clicks the confirmation link (double opt-in): confirmedAt
// is the proof that whoever owns the inbox asked for it.
model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  // SHA-256 of the emailed confirmation token; cleared once confirmed.
  confirmTokenHash String?   @unique
  confirmSentAt    DateTime?
  confirmedAt      DateTime?
  consentText      String
  ipAddress        String?
  userAgent        String?
  source           String? // where they signed up, e.g. "footer", "home"
  unsubscribeToken String    @unique
  unsubscribedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([confirmedAt])
}

// Audit row for each booking notification dispatch attempt (per recipient/channel).
model Notification {
  id              String              @id @default(cuid())
  bookingId       String
  recipientUserId String
  channel         NotificationChannel
  status          NotificationStatus  @default(SENT)
  detail          String? // e.g. provider name, or stub note
  sentAt          DateTime            @default(now())

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recipient User    @relation("UserNotifications", fields: [recipientUserId], references: [id])

  @@index([bookingId])
  @@index([recipientUserId])
}

// Two-way review, unlocked only after a booking is COMPLETED. Each participant
// (parent or sitter) may leave exactly one review per booking.
model Review {
  id        String   @id @default(cuid())
  bookingId String
  authorId  String
  subjectId String // the user being reviewed
  rating    Int // 1..5
  comment   String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author  User    @relation("ReviewsWritten", fields: [authorId], references: [id])
  subject User    @relation("ReviewsReceived", fields: [subjectId], references: [id])

  @@unique([bookingId, authorId])
  @@index([subjectId])
}

model Message {
  id        String   @id @default(cuid())
  bookingId String
  senderId  String
  content   String
  sentAt    DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id])

  @@index([bookingId])
}

// Incident/report tied to a specific booking, routed to the Admin queue.
model Report {
  id         String       @id @default(cuid())
  reporterId String
  bookingId  String
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  reporter User    @relation("Reporter", fields: [reporterId], references: [id])
  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([bookingId])
}

// Versioned waiver / terms-of-service text. The booking stores which version a
// parent accepted so we always know exactly what they agreed to.
model TermsVersion {
  id        String   @id @default(cuid())
  version   String   @unique
  body      String
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Single-row configurable business rules (Admin dashboard).
model BusinessSettings {
  id                       String  @id @default("singleton")
  lastMinuteThresholdHours Int     @default(12)
  rushFeeType              FeeType @default(PERCENT)
  rushFeeAmount            Int     @default(25) // percent, or flat CAD if FLAT
  platformFeeType          FeeType @default(PERCENT)
  platformFeeAmount        Int     @default(15) // percent, or flat CAD if FLAT

  // Minimum parent verification level required to create a booking. Launch at
  // LEVEL_1_CONTACT for low friction; tighten to LEVEL_2_IDENTITY when desired.
  minParentVerificationLevelToBook VerificationLevel @default(LEVEL_1_CONTACT)

  // --- Booking lifecycle ---
  // Who confirms completion (releases payout).
  completionConfirmedBy CompletionConfirmer @default(PARENT)
  // Notification channels beyond email (always on). Toggle on once a provider
  // (e.g. Twilio) is configured; stubbed/logged until then.
  notifySmsEnabled      Boolean             @default(false)
  notifyWhatsappEnabled Boolean             @default(false)
  // --- Booking rules ---
  // Shortest bookable session. Requests and slots below this are rejected.
  minBookingHours       Int                 @default(2)

  // --- Surcharges (flat CAD; each is charged once when the session overlaps) ---
  extraChildFeeAmount Int @default(0) // per additional child beyond the first
  lateNightFeeAmount  Int @default(0)
  lateNightStartHour  Int @default(22) // window wraps midnight: [start, end)
  lateNightEndHour    Int @default(6)
  overnightFeeAmount  Int @default(0)
  overnightStartHour  Int @default(0)
  overnightEndHour    Int @default(6)

  // --- Cancellation / refund policy ---
  // Parent cancels at least this many hours before the start → full refund.
  refundFullBeforeHours     Int @default(24)
  // Parent cancels inside this many hours of the start → lateRefundPercent.
  lateCancelWindowHours     Int @default(2)
  // Between the two windows (e.g. 2–24h out).
  midRefundPercent          Int @default(100)
  lateRefundPercent         Int @default(50)
  // At or after the start time (includes no-shows).
  afterStartRefundPercent   Int @default(0)
  // A sitter (or Ri'aya) backing out never costs the parent anything.
  sitterCancelRefundPercent Int @default(100)

  // --- Payments ---
  // Interac e-Transfer recipient shown to parents who choose to pay offline.
  // Blank hides the e-Transfer option, since there'd be nowhere to send money.
  etransferEmail String?

  // --- Support / reminders ---
  // Address quoted in reminders so both sides know who to contact.
  supportEmail String? @default("info@riaya.ca")
  // Hours before the start at which each pre-session reminder goes out. 0
  // disables that reminder.
  reminderLeadHours      Int @default(24)
  reminderFinalLeadHours Int @default(2)

  updatedAt DateTime @updatedAt
}
