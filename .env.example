# Copy to .env and fill in.
DATABASE_URL="postgresql://user:pass@host:5432/circlecare?schema=public"
# Supabase: DIRECT_URL is the direct (non-pooled) connection used for migrations.
DIRECT_URL="postgresql://user:pass@host:5432/circlecare?schema=public"

NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Business rule defaults (also editable at runtime via the admin dashboard)
LAST_MINUTE_THRESHOLD_HOURS="12"
RUSH_FEE_TYPE="PERCENT"   # PERCENT | FLAT
RUSH_FEE_AMOUNT="25"      # percent of base, or flat CAD when RUSH_FEE_TYPE=FLAT
PLATFORM_FEE_TYPE="PERCENT"  # PERCENT | FLAT
PLATFORM_FEE_AMOUNT="15"     # percent of base, or flat CAD when PLATFORM_FEE_TYPE=FLAT

# Stripe Connect (test mode)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Parent KYC / verification
# Minimum parent verification level required to book (also editable in admin).
# LEVEL_0_REGISTERED | LEVEL_1_CONTACT | LEVEL_2_IDENTITY
MIN_PARENT_VERIFICATION_LEVEL_TO_BOOK="LEVEL_1_CONTACT"
# Swappable providers. Unset = dev stub (codes/links logged to server console).
# Email is used for verification codes AND password-reset links.
# EMAIL_PROVIDER="resend"   # + RESEND_API_KEY, + EMAIL_FROM
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Ri'aya Babysitters <no-reply@yourdomain.com>"
# SMS_PROVIDER="twilio"     # + TWILIO_* credentials
# EMAIL_REPLY_TO="hello@riaya.ca"
# Private storage for gov-ID docs. Unset = local .private/ dir (single box).
# KYC_STORAGE="supabase"    # + Supabase private bucket + service key
# KYC_PRIVATE_DIR="/var/lib/riaya/id-docs"  # override local private dir
# Public storage for sitter profile photos. Unset = local .uploads/public dir.
# Point at a persistent volume in production so runtime uploads survive rebuilds.
# PUBLIC_STORAGE="supabase"  # + Supabase public bucket
# PUBLIC_UPLOAD_DIR="/data/uploads"  # override local public upload dir

# Admin alerts (new sign-up / new sitter application / new booking request).
# Recipients default to every ADMIN user in the database; override with an
# explicit comma-separated list. Each alert is on unless set to "false".
# ADMIN_ALERT_EMAILS="admin@example.com,other-admin@example.com"
# ADMIN_ALERT_SIGNUP="false"
# ADMIN_ALERT_APPLICATION="false"
# ADMIN_ALERT_BOOKING="false"
