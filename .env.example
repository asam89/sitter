# Copy to .env and fill in.
DATABASE_URL="postgresql://user:pass@host:5432/circlecare?schema=public"
# Supabase: DIRECT_URL is the direct (non-pooled) connection used for migrations.
DIRECT_URL="postgresql://user:pass@host:5432/circlecare?schema=public"

NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Business rule defaults (also editable at runtime via the admin dashboard)
LAST_MINUTE_THRESHOLD_HOURS="12"
RUSH_FEE_TYPE="PERCENT"   # PERCENT | FLAT
RUSH_FEE_AMOUNT="25"      # percent of base, or flat CAD when RUSH_FEE_TYPE=FLAT
PLATFORM_FEE_TYPE="PERCENT"  # PERCENT | FLAT
PLATFORM_FEE_AMOUNT="15"     # percent of base, or flat CAD when PLATFORM_FEE_TYPE=FLAT

# Stripe Connect (test mode)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
