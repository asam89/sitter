# Copy to .env and fill in.
DATABASE_URL="postgresql://user:pass@host:5432/circlecare?schema=public"
# Supabase: DIRECT_URL is the direct (non-pooled) connection used for migrations.
DIRECT_URL="postgresql://user:pass@host:5432/circlecare?schema=public"

NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Platform config defaults (also editable at runtime via the admin dashboard)
PLATFORM_FEE_PCT="15"
DISPATCH_FALLBACK_WINDOW_SECONDS="300"

# Stripe Connect (test mode)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
